rules_version = '2';

// TERMAI: каждый пользователь видит и меняет только свои документы.
// Деплой: firebase deploy --only firestore:rules --project termai-4fdcc
service cloud.firestore {
  match /databases/{database}/documents {
    match /users_progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users_config/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/devices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
